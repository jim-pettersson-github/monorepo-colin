    "three": "0.186.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.13",
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.2",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "6.1.1",
    "sharp": "0.35.4",
    "typescript": "5.9.3",
    "vite": "8.3.0",
    "vite-plugin-pwa": "1.3.0"
